---
import Base from '../../layouts/Base.astro';
import PropertyCard from '../../components/PropertyCard.astro';
import { PROPERTIES } from '../../data/properties';

const TYPES = ['همه', 'ویلا', 'آپارتمان', 'پنت‌هاوس', 'باغ‌ویلا'] as const;
---

<Base title="املاک" description="فهرست کامل املاک ویستا — ویلا، پنت‌هاوس و آپارتمان‌های لوکس با جزئیات کامل و تور مجازی.">
  <section class="container-v pt-32 md:pt-40">
    <p class="eyebrow mb-3" data-reveal>مجموعه ویستا</p>
    <h1 class="font-display text-4xl font-extrabold md:text-5xl" data-reveal data-reveal-delay="100">املاک</h1>
    <p class="mt-4 max-w-xl text-sm leading-7 text-muted" data-reveal data-reveal-delay="200">
      هر ملک در ویستا پیش از عرضه، ارزیابی حقوقی و فنی می‌شود — آنچه می‌بینید، قابل اعتماد است.
    </p>

    <!-- filters -->
    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal data-reveal-delay="250">
      <div class="flex flex-wrap gap-2" id="type-filter" role="group" aria-label="فیلتر نوع ملک">
        {
          TYPES.map((t, i) => (
            <button
              class:list={[
                'rounded-full border px-4 py-2 text-sm transition-all duration-300',
                i === 0
                  ? 'border-gold bg-gold text-night font-semibold'
                  : 'border-line text-ivory/75 hover:border-gold/60 hover:text-gold-bright',
              ]}
              data-type={t}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {t}
            </button>
          ))
        }
      </div>
      <div class="mr-auto">
        <select
          id="sort"
          class="rounded-full border border-line bg-surface px-4 py-2 text-sm text-ivory/85 focus:border-gold focus:outline-none"
          aria-label="مرتب‌سازی"
        >
          <option value="default">مرتب‌سازی: پیش‌فرض</option>
          <option value="price-desc">گران‌ترین</option>
          <option value="price-asc">ارزان‌ترین</option>
          <option value="area-desc">بزرگ‌ترین متراژ</option>
        </select>
      </div>
    </div>

    <div id="grid" class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROPERTIES.map((p, i) => (
          <div class="grid-item" data-reveal data-reveal-delay={String((i % 3) * 100)}>
            <PropertyCard property={p} loading={i < 3 ? 'eager' : 'lazy'} />
          </div>
        ))
      }
    </div>

    <p id="empty" class="hidden py-20 text-center text-muted">ملکی با این فیلتر پیدا نشد.</p>
  </section>
</Base>

<script>
  const grid = document.getElementById('grid')!;
  const empty = document.getElementById('empty')!;
  const items = [...grid.querySelectorAll<HTMLElement>('.grid-item')];
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('#type-filter button')];
  const sort = document.getElementById('sort') as HTMLSelectElement;

  let activeType = 'همه';

  const card = (el: HTMLElement) => el.querySelector('a')!;

  function apply() {
    // filter
    let visible = 0;
    for (const el of items) {
      const show = activeType === 'همه' || card(el).dataset.type === activeType;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    }
    empty.classList.toggle('hidden', visible > 0);

    // sort
    const key = sort.value;
    if (key !== 'default') {
      const val = (el: HTMLElement) =>
        key.startsWith('price') ? Number(card(el).dataset.price) : Number(card(el).dataset.area);
      const dir = key.endsWith('asc') ? 1 : -1;
      [...items].sort((a, b) => (val(a) - val(b)) * dir).forEach((el) => grid.appendChild(el));
    }
  }

  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      activeType = btn.dataset.type!;
      for (const b of buttons) {
        const on = b === btn;
        b.setAttribute('aria-pressed', String(on));
        b.classList.toggle('border-gold', on);
        b.classList.toggle('bg-gold', on);
        b.classList.toggle('text-night', on);
        b.classList.toggle('font-semibold', on);
        b.classList.toggle('border-line', !on);
        b.classList.toggle('text-ivory/75', !on);
      }
      apply();
    });
  }
  sort.addEventListener('change', apply);
</script>
