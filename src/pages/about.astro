---
import Base from '../layouts/Base.astro';
import { SITE, url, faNum } from '../lib/site';

const VALUES = [
  {
    title: 'گزیده، نه انبوه',
    text: 'هر ملک پیش از عرضه، از نظر حقوقی و فنی ارزیابی می‌شود. در ویستا به جای فهرست بلند، فهرست قابل اعتماد می‌بینید.',
  },
  {
    title: 'شفافیت کامل',
    text: 'قیمت، وضعیت سند و جزئیات فنی همان چیزی است که می‌خوانید — بدون ستاره و تبصره پنهان.',
  },
  {
    title: 'تجربه پیش از بازدید',
    text: 'با تور مجازی ۳۶۰ درجه، پیش از هماهنگی بازدید، در ملک قدم می‌زنید و وقت‌تان صرف گزینه‌های جدی می‌شود.',
  },
  {
    title: 'همراهی تا سند',
    text: 'از اولین تماس تا انتقال قطعی سند، مشاور اختصاصی شما پاسخ‌گوست — پیش و پس از معامله.',
  },
] as const;
---

<Base title="درباره ویستا" description="ویستا — تیمی کوچک با استانداردی سخت‌گیرانه برای املاک لوکس.">
  <!-- hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0">
      <img src={url('/img/hero.jpg')} alt="" aria-hidden="true" class="h-full w-full object-cover opacity-35" />
      <div class="absolute inset-0 bg-gradient-to-b from-night/70 via-night/85 to-night"></div>
    </div>
    <div class="container-v relative pt-36 pb-20 md:pt-44">
      <p class="eyebrow mb-4" data-reveal>درباره ما</p>
      <h1 class="font-display max-w-2xl text-4xl font-extrabold leading-[1.3] md:text-5xl" data-reveal data-reveal-delay="100">
        ویستا یعنی <span class="text-gold-bright">چشم‌انداز</span> — و ما چشم‌انداز شما به خانه بعدی هستیم
      </h1>
      <p class="mt-6 max-w-xl text-base leading-9 text-ivory/80" data-reveal data-reveal-delay="220">
        ویستا با یک باور ساده شروع شد: خرید خانه لوکس نباید پر از ابهام باشد. ما تعداد کمی ملک را با وسواس انتخاب می‌کنیم،
        همه جزئیاتش را شفاف می‌گوییم و با تور مجازی، تجربه دیدن ملک را به قبل از بازدید می‌آوریم.
      </p>
    </div>
  </section>

  <!-- values -->
  <section class="container-v mt-8 md:mt-16">
    <div class="grid gap-6 sm:grid-cols-2">
      {
        VALUES.map((v, i) => (
          <div class="rounded-2xl border border-line bg-surface/60 p-7" data-reveal data-reveal-delay={String((i % 2) * 120)}>
            <div class="font-display flex items-center gap-3 text-lg font-bold">
              <span class="text-gold">✦</span>
              {v.title}
            </div>
            <p class="mt-3 text-sm leading-8 text-muted">{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- numbers -->
  <section class="container-v mt-16">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4" data-reveal>
      {
        [
          { n: faNum(120) + '+', l: 'ملک تحویل‌شده' },
          { n: faNum(14), l: 'سال تجربه' },
          { n: faNum(6), l: 'شهر فعال' },
          { n: '۹۸٪', l: 'رضایت مشتریان' },
        ].map((s) => (
          <div class="bg-surface px-6 py-8 text-center">
            <div class="font-display text-3xl font-extrabold text-gold-bright">{s.n}</div>
            <div class="mt-2 text-xs text-muted md:text-sm">{s.l}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <section class="container-v mt-20">
    <div class="rounded-3xl border border-line bg-surface px-8 py-12 text-center" data-reveal>
      <h2 class="font-display text-2xl font-bold md:text-3xl">دوست دارید از نزدیک آشنا شویم؟</h2>
      <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-muted">دفتر ویستا میزبان شماست — یا هر جا که راحت‌ترید.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-4">
        <a href={url('/contact')} class="btn-gold">تماس با ما</a>
        <a href={SITE.whatsapp} target="_blank" rel="noopener" class="btn-ghost">واتساپ</a>
      </div>
    </div>
  </section>
</Base>
